{
  "manifest_version": 3,
  "name": "Pausemark",
  "description": "Save words and phrases from the web with source context and optional AI explanations.",
  "version": "0.1.0",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Pausemark",
    "default_popup": "popup.html"
  },
  "commands": {
    "save-selected-snippet": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Save selected snippet to Pausemark"
    }
  },
  "options_page": "options.html"
}
